import numpy as np
import matplotlib.pyplot as plt

mu_0 = 4 * np.pi * 1e-7
I = 1
R = 1
N = 100
theta = np.linspace(0, 2 * np.pi, N)
dl = (2 * np.pi * R / N) * np.array([-np.sin(theta), np.cos(theta), np.zeros(N)])

x_range = np.linspace(-2, 2, 20)
z_range = np.linspace(-2, 2, 20)
X, Z = np.meshgrid(x_range, z_range)
Bx, Bz = np.zeros_like(X), np.zeros_like(Z)

for i in range(N):
    r0 = np.array([R * np.cos(theta[i]), R * np.sin(theta[i]), 0])
    
    for j in range(len(x_range)):
        for k in range(len(z_range)):
            r = np.array([X[j, k], 0, Z[j, k]]) - r0
            r_magnitude = np.linalg.norm(r)
            
            if r_magnitude == 0:
                continue
            
            dB = (mu_0 * I / (4 * np.pi)) * np.cross(dl[:, i], r) / r_magnitude**3
            Bx[j, k] += dB[0]
            Bz[j, k] += dB[2]

B_magnitude = np.sqrt(Bx**2 + Bz**2)
plt.figure(figsize=(8, 6))
plt.quiver(X, Z, Bx / B_magnitude, Bz / B_magnitude, B_magnitude, cmap='plasma')
plt.colorbar(label='Intensidad del campo magnético')
plt.xlabel('X')
plt.ylabel('Z')
plt.title('Campo Magnético de una Espira Circular')
plt.show()
